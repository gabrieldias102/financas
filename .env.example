# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Pluggy: dashboard.pluggy.ai > sua aplicação
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# IDs dos items do Meu Pluggy, separados por vírgula (veja o README)
PLUGGY_ITEM_IDS=

# Postgres (Supabase: Project Settings > Database > Connection string, modo "Transaction pooler")
DATABASE_URL=postgres://postgres:postgres@localhost:5432/financas

# Senha para entrar no app
APP_PASSWORD=
# Texto aleatório de 32+ caracteres: openssl rand -base64 32
SESSION_SECRET=
# Senha que o Vercel Cron usa para chamar /api/sync: openssl rand -base64 32
CRON_SECRET=
